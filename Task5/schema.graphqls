type Query {
    client(id: ID!): Client
}

type Client {
    id: ID!
    name: String!
    age: Int!
    documents: [Document!]!
    relatives: [Relative!]!
}

type Document {
    id: ID!
    type: String!
    number: String!
    issueDate: String!
    expiryDate: String!
}

type Relative {
    id: ID!
    relationType: String!
    name: String!
    age: Int!
}

# Примеры запросов

# Получить информацию о клиенте по ID
query {
    client(id: "123") {
        name
        age
    }
}

# Список документов клиента
query {
    client(id: "123") {
        documents {
            id
            type
            number
            issueDate
            expiryDate
        }
    }
}

# Информация о родственниках клиента
query {
    client(id: "123") {
        relatives {
            id
            relationType
            name
            age
        }
    }
}
